# OSA reads these OPTIONAL variables from the environment. None is required; every feature degrades
# gracefully without its key. Never commit real values (OSA never writes them anywhere).

# Raises GitHub's unauthenticated limits (60 core requests/hour, 10 searches/minute) and enables code search
# in the prior-art lookup. A fine-grained token with no extra scopes (public read-only) is enough.
# OSA looks for OSA_GITHUB_TOKEN first and GITHUB_TOKEN second. Prefer OSA_GITHUB_TOKEN: a global GITHUB_TOKEN also takes over the `gh` command's login.
OSA_GITHUB_TOKEN=

# OpenAlex: without a key, requests share one small free daily budget per IP address (the `mailto` setting in
# osa.config.json does NOT raise it). A free key from your OpenAlex account settings gives a larger budget.
OPENALEX_API_KEY=

# Embeddings key for the optional "hybrid" code search (index.engine: "hybrid"; docs/osa/SEMANTIC.md). The variable NAME is set in
# osa.config.json (index.semantic.apiKeyEnv, default OSA_EMBEDDINGS_API_KEY). A local embeddings server needs no key.
OSA_EMBEDDINGS_API_KEY=

# Semantic Scholar: only used when `research.semanticScholar` is true in osa.config.json AND this is set.
S2_API_KEY=
